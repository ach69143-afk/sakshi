# SAKSHI Frontend Environment Configuration
# Backend API Base URL
# For Vercel production deployment connecting to Render FastAPI backend:
VITE_API_URL=https://sakshi-ssws.onrender.com

# For local development with Vite dev server proxy to http://127.0.0.1:8000:
# (Leave VITE_API_URL empty or unset in .env.local to use the Vite proxy)
# VITE_API_URL=
